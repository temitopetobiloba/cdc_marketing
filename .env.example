# Copy to .env and fill in, then:  set -a; source .env; set +a
# .env is git-ignored. NEVER commit real values.

# SQL warehouse > Connection details
DATABRICKS_HOST=adb-xxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx

# Development only: your personal access token
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX
DBT_DEV_CATALOG=third_layer
DBT_DEV_SCHEMA=marketing_dev

# Where the raw (bronze) tables are
DBT_RAW_CATALOG=third_layer
DBT_RAW_SCHEMA=marketing_staging

# Production (normally only set in GitHub secrets, not on your laptop)
# DATABRICKS_CLIENT_ID=<service principal application id>
# DATABRICKS_CLIENT_SECRET=<service principal OAuth secret>
